COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-english-v3.0

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_db

# Semantic chunking: break when adjacent sentence similarity falls below this percentile (0-100)
SEMANTIC_CHUNK_BREAKPOINT_PERCENTILE=90
# Maximum characters per chunk (safety cap)
SEMANTIC_CHUNK_MAX_CHARS=2000

# Embedding batch size for Cohere API
EMBED_BATCH_SIZE=96

# Scan chunk text for PII patterns and enrich metadata (email, phone, SSN, etc.)
DETECT_PII_IN_CHUNKS=true
